<Window x:Class="AirLyrics.App.Views.SpotifyLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar Spotify - AirLyrics"
        Icon="pack://application:,,,/logo.png"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#0F172A" 
            BorderBrush="#334155" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="✦ Conectar con Spotify" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#1DB954"/>
                <TextBlock Text="Inicia sesión con tu cuenta de Spotify mediante autorización segura oficial." 
                           FontSize="12" 
                           Foreground="#94A3B8" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Contenido -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="Spotify Client ID:" 
                           Foreground="#F8FAFC" 
                           FontWeight="SemiBold" 
                           FontSize="13"/>
                
                <TextBox x:Name="ClientIdInput" 
                         Height="38" 
                         Margin="0,6,0,0" 
                         Background="#1E293B" 
                         Foreground="#FFFFFF" 
                         CaretBrush="#1DB954"
                         BorderBrush="#334155" 
                         BorderThickness="1" 
                         Padding="8,6" 
                         FontSize="13" 
                         VerticalContentAlignment="Center"/>

                <Border Background="#1E293B" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,14,0,0" 
                        BorderBrush="#334155" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ℹ️ ¿Cómo obtener tu Client ID?" 
                                   FontWeight="Bold" 
                                   Foreground="#38BDF8" 
                                   FontSize="12"/>
                        <TextBlock Text="1. Ve a developer.spotify.com/dashboard y crea una app." 
                                   Foreground="#94A3B8" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="2. En Settings de la app, añade como Redirect URI: http://127.0.0.1:5543/callback/" 
                                   Foreground="#94A3B8" 
                                   FontSize="11" 
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="3. Copia tu Client ID y pégalo aquí arriba." 
                                   Foreground="#94A3B8" 
                                   FontSize="11" 
                                   Margin="0,2,0,0"/>
                        
                        <Button Content="Abrir Spotify Developer Dashboard ↗" 
                                Click="OpenDashboard_Click" 
                                Margin="0,8,0,0" 
                                HorizontalAlignment="Left" 
                                Background="Transparent" 
                                Foreground="#1DB954" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                FontSize="11" 
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de estado -->
                <TextBlock x:Name="StatusMessage" 
                           Text="" 
                           Foreground="#EF4444" 
                           FontSize="12" 
                           Margin="0,10,0,0" 
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Botones de Acción -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" 
                        Click="Cancel_Click" 
                        Padding="14,8" 
                        Background="#334155" 
                        Foreground="#FFFFFF" 
                        BorderThickness="0" 
                        Margin="0,0,10,0" 
                        Cursor="Hand"/>
                
                <Button x:Name="LoginButton"
                        Content="Abrir Login en Navegador ➔" 
                        Click="StartLogin_Click" 
                        Padding="16,8" 
                        Background="#1DB954" 
                        Foreground="#FFFFFF" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
