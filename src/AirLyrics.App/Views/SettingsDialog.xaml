<Window x:Class="AirLyrics.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes - AirLyrics"
        Icon="pack://application:,,,/logo.png"
        Height="470" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" 
            BorderBrush="#334155" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera -->
                <RowDefinition Height="*"/>    <!-- Opciones -->
                <RowDefinition Height="Auto"/> <!-- Acciones -->
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="⚙️ Ajustes de AirLyrics" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#38BDF8"/>
                    <TextBlock Text="Personaliza tus atajos globales y preferencias" 
                               FontSize="11" 
                               Foreground="#94A3B8" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="✕" 
                        Click="Cancel_Click" 
                        Background="Transparent" 
                        Foreground="#94A3B8" 
                        BorderThickness="0" 
                        FontSize="14" 
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>

            <!-- Contenido de Ajustes -->
            <StackPanel Grid.Row="1">
                <!-- Sección 1: Atajo Global Modo Fantasma con Detección Automática de Teclas (Estilo Videojuegos) -->
                <Border Background="#1E293B" 
                        BorderBrush="#334155" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="14" 
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⌨️ Atajo Global para Modo Fantasma" 
                                   FontWeight="Bold" 
                                   Foreground="#F8FAFC" 
                                   FontSize="13"/>
                        <TextBlock Text="Funciona en cualquier momento, incluso dentro de juegos u otras apps." 
                                   Foreground="#94A3B8" 
                                   FontSize="11" 
                                   Margin="0,2,0,10"/>

                        <!-- Modificadores -->
                        <TextBlock Text="Teclas Modificadoras:" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkCtrl" Content="Ctrl" Checked="ShortcutChanged" Unchecked="ShortcutChanged"/>
                            <CheckBox x:Name="ChkAlt" Content="Alt" Checked="ShortcutChanged" Unchecked="ShortcutChanged"/>
                            <CheckBox x:Name="ChkShift" Content="Shift" Checked="ShortcutChanged" Unchecked="ShortcutChanged"/>
                            <CheckBox x:Name="ChkWin" Content="Win" Checked="ShortcutChanged" Unchecked="ShortcutChanged"/>
                        </WrapPanel>

                        <!-- Detección Interactiva de Tecla (Estilo Videojuego) -->
                        <TextBlock Text="Tecla Principal (Haz clic para asignar presionando una tecla):" 
                                   Foreground="#CBD5E1" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,6"/>
                        
                        <Button x:Name="KeyBindingButton" 
                                Height="40" 
                                Click="KeyBindingButton_Click"
                                PreviewKeyDown="KeyBindingButton_PreviewKeyDown"
                                LostFocus="KeyBindingButton_LostFocus"
                                Background="#0F172A" 
                                Foreground="#38BDF8" 
                                BorderBrush="#334155" 
                                BorderThickness="1.5"
                                FontSize="13" 
                                FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="8" 
                                            Padding="10,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="KeyBindingText" Text="[ G ]" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="  • (Haz clic y presiona cualquier tecla)" Foreground="#64748B" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Atajo resultante -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10,7" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Atajo asignado:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ShortcutPreviewText" 
                                           Text="Ctrl + Alt + G" 
                                           FontWeight="Bold" 
                                           Foreground="#38BDF8" 
                                           FontSize="13" 
                                           Margin="8,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sección 2: Restablecer Valores -->
                <Border Background="#1E293B" 
                        BorderBrush="#334155" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Valores de Fábrica" 
                                       FontWeight="Bold" 
                                       Foreground="#F8FAFC" 
                                       FontSize="12"/>
                            <TextBlock Text="Restablece color, fuente y atajos a su estado inicial." 
                                       Foreground="#94A3B8" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="⚠️ Restablecer" 
                                Click="ResetDefaults_Click" 
                                Style="{StaticResource DialogBtn}"
                                Foreground="#F87171"
                                BorderBrush="#991B1B"
                                Padding="10,5"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Botones Guardar / Cancelar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" 
                        Click="Cancel_Click" 
                        Style="{StaticResource DialogBtn}" 
                        Margin="0,0,8,0"/>
                
                <Button Content="Guardar Ajustes" 
                        Click="Save_Click" 
                        Style="{StaticResource DialogBtn}" 
                        Background="#38BDF8" 
                        Foreground="#0F172A" 
                        BorderThickness="0" 
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
