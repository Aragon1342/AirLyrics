<Window x:Class="AirLyrics.App.Views.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirLyrics"
        Icon="pack://application:,,,/logo.png"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ModalBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" 
            BorderBrush="#334155" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="22"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="Black" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera / Título con Icono Colorido -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Contenedor del Icono con Color y Fondo Suave -->
                    <Border x:Name="IconBadge"
                            Width="32" Height="32" 
                            CornerRadius="16" 
                            Background="#20EF4444" 
                            Margin="0,0,10,0">
                        <TextBlock x:Name="IconText" 
                                   Text="⚠" 
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Arial"
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#EF4444" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TitleText" 
                               Text="Título del Mensaje" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="✕" 
                        Click="Close_Click" 
                        Background="Transparent" 
                        Foreground="#94A3B8" 
                        BorderThickness="0" 
                        FontSize="13" 
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>

            <!-- Contenido del Mensaje -->
            <TextBlock Grid.Row="1" 
                       x:Name="MessageText" 
                       Text="Mensaje de confirmación o alerta." 
                       FontSize="13" 
                       Foreground="#CBD5E1" 
                       TextWrapping="Wrap" 
                       LineHeight="19"
                       Margin="0,0,0,20"/>

            <!-- Botones de Acción -->
            <StackPanel Grid.Row="2" 
                        x:Name="ButtonsPanel" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <!-- Botón Secundario (No / Cancelar) -->
                <Button x:Name="SecondaryButton" 
                        Content="Cancelar" 
                        Click="SecondaryButton_Click" 
                        Style="{StaticResource ModalBtn}" 
                        Margin="0,0,8,0"
                        Visibility="Collapsed"/>

                <!-- Botón Primario (Aceptar / Sí) -->
                <Button x:Name="PrimaryButton" 
                        Content="Aceptar" 
                        Click="PrimaryButton_Click" 
                        Style="{StaticResource ModalBtn}"
                        Background="#38BDF8" 
                        Foreground="#0F172A" 
                        BorderThickness="0" 
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
